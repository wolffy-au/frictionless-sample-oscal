@startuml component-definition-gcp-firestore-sc28
' Structure of component-definitions/gcp-firestore-sc28/component-definition.json
' (step 3c, platform-specific) and how it relates to the organisation profile,
' the technology-agnostic checks (3a), the SSP and the sample-gcp deployment.
' The GCP counterpart of azure-sql-sc28.puml.
' Package names use '_' instead of '.' (PlantUML splits package names on '.').
' Body lines must not start with '-', '+', '#' or '~' (rendered as UML
' visibility icons) or with '..' (rendered as a separator).
title Component definition 3c: Cloud Firestore for SC-28 + SC-28(1)
hide circle
skinparam packageStyle rectangle
skinparam object {
  BackgroundColor<<service>> #DDEBF7
  BackgroundColor<<validation>> #E2F0D9
  BackgroundColor<<requirement>> #FFF2CC
  BackgroundColor<<upstream>> #F2F2F2
  BackgroundColor<<gcp>> #EDEDED
  BackgroundColor<<gap>> #F8CBAD
  BackgroundColor<<code>> #C6EFCE
}

legend right
  |= Line |= Meaning |
  | solid arrow | direct reference (href / source / uuid) |
  | dashed arrow | match by shared identifier (same value on both sides) |
endlegend

' ======================= UPSTREAM OSCAL =======================
package "profiles/sc28-org/profile_json (2b)" {
  object "organisation profile" as org <<upstream>> {
    imports 2a (NIST MODERATE extract)
    sc-28_odp.02, sc-28.01_odp.01/02 values
    constraint: sc-28_odp.01 = both
    guidance: tamper evidence accepted for obj-2
  }
}

package "component-definitions/datastore-checks (3a, technology-agnostic)" {
  object "component: OPA datastore checks" as val <<validation>> {
    type = validation
    rule_set_00
      Rule_Id  = datastore_encrypted_at_rest
      Check_Id = encryption_at_rest
    rule_set_01
      Rule_Id  = datastore_tamper_evident
      Check_Id = tamper_evidence
  }
}

' ======================= THIS COMPONENT DEFINITION =======================
package "component-definitions/gcp-firestore-sc28/component-definition_json (3c)" {
  object "component-definition" as cdroot <<service>> {
    import-component-definitions href:
      trestle://component-definitions/datastore-checks/...
  }
  object "component: Cloud Firestore" as svc <<service>> {
    type = service
    no rule definitions of its own
    remarks: adapter mapping
      always encrypted  = encryption_at_rest.enabled
      no tamper feature = tamper_evidence.enabled false
  }
  object "control-implementation" as ci <<service>> {
    source = trestle://profiles/sc28-org/profile.json
    no set-parameters (values are in 2b and the SSP)
  }
  object "implemented-requirement: sc-28" as ir28 <<requirement>> {
    Rule_Id = datastore_encrypted_at_rest  (confidentiality: server-side)
    Rule_Id = datastore_tamper_evident     (integrity: not provided)
  }
  object "implemented-requirement: sc-28.1" as ir281 <<requirement>> {
    obj-1 disclosure:   server-side encryption,
                        Google-managed keys or CMEK
    obj-2 modification: needs a mechanism added
                        outside Firestore
    same two Rule_Ids
  }
}

' ======================= DOWNSTREAM =======================
package "system-security-plans/sample-gcp (step 4)" {
  object "component: Cloud Firestore" as ssp_comp <<service>> {
    same uuid as in 3c
    link rel = component-definition
  }
  object "inventory-item: (default)" as ssp_inv <<gcp>> {
    asset-id = projects/<project_id>/databases/(default)
  }
}

package "test-gcp/main_tf" {
  object "google_firestore_database\n(default)" as fs_db <<gcp>> {
    Standard edition, Native mode
    no cmek_config
      so Google-managed keys
    firestore.rules: clients cannot
      update or delete
  }
}

object "automation/gcp_terraform_inventory_py\n(GCP adapter)" as adapter <<code>> {
  parses main.tf with python-hcl2
  implements the mapping in the remarks
  (default): encrypted = true, tamper-evident = false
}

object "FINDING (step 6) -> POA&M (step 7)" as gap <<gap>> {
  tamper_evidence fails for (default)
  sc-28.1_obj-2 and sc-28_obj not-satisfied
  POA&M: 4 candidate remediations, none chosen
}

' containment
cdroot *-- svc : components
svc *-- ci : control-implementations
ci *-- ir28
ci *-- ir281

' direct references (solid)
cdroot --> val : import-component-definitions
ci --> org : source
ssp_comp --> svc : links (component-definition)
ssp_inv --> ssp_comp : implemented-components

' shared identifiers (dashed)
ir28 ..> val : Rule_Id
ir281 ..> val : Rule_Id

' evidence path
fs_db --> adapter : python-hcl2\nmain.tf.json
ssp_inv .. fs_db
gap .. adapter
@enduml

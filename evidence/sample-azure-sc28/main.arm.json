      ]
    },
    {
      "type": "Microsoft.Web/staticSites/config",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}/{1}', format('{0}-plan', parameters('appName')), 'appsettings')]",
      "kind": "string",
      "properties": {

        "SQL_USER": "[parameters('dbAdminUsername')]",
        "SQL_PASSWORD": "[parameters('dbAdminPassword')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('dbServerName'))]",
        "[resourceId('Microsoft.Web/staticSites', format('{0}-plan', parameters('appName')))]"
      ]
    }
  ],
  "outputs": {
    "staticWebAppName": {
      "type": "string",
      "value": "[format('{0}-plan', parameters('appName'))]"

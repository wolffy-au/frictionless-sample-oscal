  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "[format('web-tier-{0}', uniqueString(resourceGroup().id))]"
    },
    "location": {
      "type": "string",
      "defaultValue": "centralus"
    },
    "dbServerName": {
      "type": "string",
      "defaultValue": "[format('sql-tier-{0}', uniqueString(resourceGroup().id))]"
    },
    "dbName": {
      "type": "string",
      "defaultValue": "appdb"
    },
    "dbAdminUsername": {
      "type": "string",
      "defaultValue": "azureuser"
    },
    "dbAdminPassword": {
      "type": "securestring"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-plan', parameters('appName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Free",
        "tier": "Free"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2025-01-01",
      "name": "[parameters('dbServerName')]",
      "location": "[parameters('location')]",

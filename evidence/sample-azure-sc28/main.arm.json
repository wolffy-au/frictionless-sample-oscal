        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 2
      },
      "properties": {
        "useFreeLimit": true,
        "freeLimitExhaustionBehavior": "AutoPause",
        "maxSizeBytes": 34359738368,
        "requestedBackupStorageRedundancy": "Local"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('dbServerName'))]"
